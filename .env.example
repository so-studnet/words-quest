# Copy this file to .env.local and fill in the values. Never commit .env.local.
# On Vercel, set the same names under Settings -> Environment Variables.

# Groq API key (console.groq.com -> API Keys). Secret: server only.
GROQ_API_KEY=
# Optional: model id from console.groq.com -> Models (default: openai/gpt-oss-120b)
GROQ_MODEL=

# Supabase (optional: without these there is no cache and no rate limit)
# Project URL: https://<project-id>.supabase.co
SUPABASE_URL=
# Secret key (sb_secret_...). Secret: server only. Never use NEXT_PUBLIC_ for it.
SUPABASE_SECRET_KEY=

# Optional limits (AI lookups; cached results are not counted)
RATE_LIMIT_PER_HOUR=
AI_DAILY_LIMIT=

# Optional: other sites whose browsers may call /api/v1/lookup (comma-separated, or *)
ALLOWED_ORIGINS=

# Sign-in and study log (optional; public values, data is protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Word of the Day push notifications (make the keys at /tools/keys on your site)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Secret: server only
VAPID_PRIVATE_KEY=
# mailto: + your email (iPhone requires this form)
VAPID_SUBJECT=
# Secret: the hourly Supabase job sends this as a Bearer token
CRON_SECRET=
